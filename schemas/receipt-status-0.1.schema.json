{"$id":"https://example.invalid/oev/schemas/receipt-status-0.1.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Signed, dated set of receipt statuses (oev-receipt-status/0.1, V3-C13 freshness & supersession). The snapshot payload is DSSE-signed by a status signer; snapshot_time_claimed is a claimed time, not a trusted timestamp.","properties":{"entries":{"items":{"additionalProperties":false,"properties":{"effective_at_claimed":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$","type":"string"},"reason":{"type":"string"},"receipt_digest":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"receipt_id":{"minLength":1,"type":"string"},"status":{"enum":["CURRENT","STALE","SUPERSEDED","REVOKED"],"type":"string"},"supersedes":{"additionalProperties":false,"properties":{"receipt_digest":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"receipt_id":{"minLength":1,"type":"string"}},"required":["receipt_id","receipt_digest"],"type":"object"}},"required":["receipt_digest","status"],"type":"object"},"maxItems":1024,"type":"array"},"issuer_key_id":{"minLength":1,"type":"string"},"protocol_version":{"enum":["oev-receipt-status/0.1"],"type":"string"},"snapshot_time_claimed":{"minLength":1,"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$","type":"string"}},"required":["protocol_version","issuer_key_id","snapshot_time_claimed","entries"],"title":"OEVP Receipt Status Snapshot","type":"object"}