{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oev/schemas/decision-pack-review-actions.schema.json",
  "title": "OEVP Decision Pack Review Actions",
  "description": "Human or system review actions recorded for a decision case (oev-decision-pack/0.2). Recording an action is evidence that it was performed; it is not evidence that the action was correct.",
  "type": "object",
  "required": ["protocol_version", "case_id", "review_actions"],
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": ["oev-decision-pack/0.2"]
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "review_actions": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["action_id", "action_type", "actor", "performed_at"],
        "properties": {
          "action_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "action_type": {
            "type": "string",
            "enum": ["APPROVE", "REJECT", "REQUEST_CHANGES", "ESCALATE", "COMMENT"]
          },
          "actor": {
            "type": "object",
            "required": ["actor_id"],
            "properties": {
              "actor_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "actor_type": {
                "type": "string",
                "maxLength": 64
              },
              "display_name": {
                "type": "string",
                "maxLength": 256
              }
            },
            "additionalProperties": false
          },
          "performed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "references_finding_ids": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          },
          "references_rule_run_ids": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          },
          "note": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
