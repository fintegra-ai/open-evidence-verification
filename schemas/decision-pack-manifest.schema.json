{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oev/schemas/decision-pack-manifest.schema.json",
  "title": "OEVP Decision Pack Manifest",
  "description": "SHA-256 manifest covering every member of a decision evidence pack in stable, lexicographic path order (oev-decision-pack/0.2).",
  "type": "object",
  "required": [
    "protocol_version",
    "pack_id",
    "case_id",
    "created_at",
    "members",
    "pack_digest"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": ["oev-decision-pack/0.2"]
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "creator": {
      "type": "object",
      "required": ["software", "version"],
      "properties": {
        "software": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "media_type",
          "canonicalization",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._/-]{0,254}$",
            "not": {
              "pattern": "(^|/)\\.\\.?(/|$)"
            }
          },
          "role": {
            "type": "string",
            "enum": [
              "case",
              "facts",
              "rule_runs",
              "findings",
              "review_actions",
              "timeline",
              "snapshot_context",
              "artifact"
            ]
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "canonicalization": {
            "type": "string",
            "enum": ["jcs-rfc8785", "raw"]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "pack_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
