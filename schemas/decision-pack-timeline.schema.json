{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oev/schemas/decision-pack-timeline.schema.json",
  "title": "OEVP Decision Pack Timeline",
  "description": "Ordered event log for a decision case (oev-decision-pack/0.2). Events are recorded in strictly increasing sequence order.",
  "type": "object",
  "required": ["protocol_version", "case_id", "events"],
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": ["oev-decision-pack/0.2"]
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["event_id", "sequence", "event_type", "occurred_at", "summary"],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "event_type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "occurred_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "actor": {
            "type": "string",
            "maxLength": 256
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "references": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": ["kind", "id"],
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
