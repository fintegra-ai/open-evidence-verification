{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oev/schemas/decision-pack-snapshot-context.schema.json",
  "title": "OEVP Decision Pack Snapshot Context",
  "description": "Context snapshot binding a decision case to the source state it was made against (oev-decision-pack/0.2). Sources are content-addressed so replay tooling can pin to the exact snapshot.",
  "type": "object",
  "required": ["protocol_version", "case_id", "snapshot_id", "captured_at", "sources"],
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": ["oev-decision-pack/0.2"]
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "captured_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "generator": {
      "type": "object",
      "required": ["software", "version"],
      "properties": {
        "software": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["source_id", "kind", "digest"],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "retrieved_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "note": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "additionalProperties": false
      }
    },
    "parameters": {
      "type": "object"
    },
    "notes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    }
  },
  "additionalProperties": false
}
