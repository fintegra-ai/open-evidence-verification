{"$id":"https://example.invalid/oev/schemas/execution-log-event-0.1.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"One hash-chained execution log event (oev-execution-log/0.1, HEA design §4.2).","properties":{"check_id":{"minLength":1,"type":"string"},"claimed_time":{"minLength":1,"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"event_digest":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"event_type":{"enum":["EXECUTION_STARTED","CHECK_COMPLETED","EXECUTION_COMPLETED","EXECUTION_FAILED","CHECKPOINT"],"type":"string"},"execution_id":{"pattern":"^exec_[0-9a-f]{32}$","type":"string"},"leaf_hash":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"log_id":{"minLength":1,"type":"string"},"prev_hash":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"protocol_version":{"enum":["oev-execution-log/0.1"],"type":"string"},"seq":{"minimum":0,"type":"integer"}},"required":["protocol_version","log_id","seq","event_type","execution_id","event_digest","prev_hash","claimed_time"],"title":"OEVP Execution Log Event","type":"object"}