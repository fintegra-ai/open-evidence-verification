{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oev/schemas/decision-pack-rule-runs.schema.json",
  "title": "OEVP Decision Pack Rule Runs",
  "description": "Recorded executions of versioned rules-as-data over recorded facts (oev-decision-pack/0.2). Outcomes are honest execution records, not verdicts of correctness.",
  "type": "object",
  "required": ["protocol_version", "case_id", "rule_runs"],
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": ["oev-decision-pack/0.2"]
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "rule_runs": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["run_id", "rule", "inputs", "outcome", "executed_at", "executed_by"],
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "rule": {
            "type": "object",
            "required": ["rule_id", "rule_version", "rule_digest"],
            "properties": {
              "rule_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "rule_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "rule_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "description": {
                "type": "string",
                "maxLength": 1024
              },
              "condition": {
                "type": "object"
              },
              "parameters": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "inputs": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            }
          },
          "outcome": {
            "type": "string",
            "enum": [
              "TRIGGERED",
              "NOT_TRIGGERED",
              "REVIEW_REQUIRED",
              "UNVERIFIABLE",
              "HASH_MISMATCH"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 4096
          },
          "executed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "executed_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
