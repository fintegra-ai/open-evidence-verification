{"$id":"https://example.invalid/oev/schemas/revocation-list-0.1.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Signed list of revoked key ids (oev-revocation/0.1, HEA design §9.1).","properties":{"entries":{"items":{"additionalProperties":false,"properties":{"key_id":{"minLength":1,"type":"string"},"reason":{"minLength":1,"type":"string"},"revoked_at_claimed":{"minLength":1,"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}},"required":["key_id","reason","revoked_at_claimed"],"type":"object"},"type":"array"},"issued_at_claimed":{"minLength":1,"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"issuer_key_id":{"minLength":1,"type":"string"},"protocol_version":{"enum":["oev-revocation/0.1"],"type":"string"}},"required":["protocol_version","issuer_key_id","issued_at_claimed","entries"],"title":"OEVP Revocation List","type":"object"}