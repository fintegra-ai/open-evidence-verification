{"$id":"https://example.invalid/oev/schemas/log-checkpoint-0.1.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Signed summary of a log prefix (oev-log-checkpoint/0.1, HEA design §4.4). checkpoint_seq is the number of leaves covered (the next seq to be written), equal to leaf_count.","properties":{"checkpoint_seq":{"minimum":0,"type":"integer"},"claimed_time":{"minLength":1,"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"leaf_count":{"minimum":0,"type":"integer"},"log_id":{"minLength":1,"type":"string"},"merkle_root":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"prev_checkpoint_digest":{"pattern":"^sha256:[0-9a-f]{64}$","type":"string"},"protocol_version":{"enum":["oev-log-checkpoint/0.1"],"type":"string"}},"required":["protocol_version","log_id","checkpoint_seq","merkle_root","leaf_count","prev_checkpoint_digest","claimed_time"],"title":"OEVP Log Checkpoint","type":"object"}