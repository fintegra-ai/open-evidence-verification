{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oev/schemas/decision-pack-facts.schema.json",
  "title": "OEVP Decision Pack Facts",
  "description": "Recorded input facts for a decision evidence pack (oev-decision-pack/0.2). Facts are recorded observations attributed to a source; they are not asserted to be true.",
  "type": "object",
  "required": ["protocol_version", "case_id", "facts"],
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": ["oev-decision-pack/0.2"]
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "facts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": ["fact_id", "key", "value", "source", "observed_at"],
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "value": {},
          "value_type": {
            "type": "string",
            "maxLength": 64
          },
          "unit": {
            "type": "string",
            "maxLength": 64
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "observed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "snapshot_source_id": {
            "type": "string",
            "maxLength": 128
          },
          "note": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
