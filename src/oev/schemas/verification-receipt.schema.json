{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/oev/schemas/verification-receipt.schema.json",
  "title": "OEVP Verification Receipt",
  "description": "Provisional specification for a portable evidence verification receipt (oev-receipt/0.1).",
  "type": "object",
  "required": [
    "receipt_id",
    "protocol_version",
    "recorded_verification_time",
    "package",
    "profile",
    "verifier",
    "trust_inputs",
    "checks",
    "limitations",
    "overall_result",
    "receipt_digest"
  ],
  "properties": {
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "enum": ["oev-receipt/0.1"]
    },
    "recorded_verification_time": {
      "type": "string",
      "format": "date-time"
    },
    "package": {
      "type": "object",
      "required": ["digest", "format"],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "declared_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "required": ["profile_id", "profile_version", "profile_digest"],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        },
        "profile_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "verifier": {
      "type": "object",
      "required": ["software", "version"],
      "properties": {
        "software": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "trust_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trust_id", "type", "digest"],
        "properties": {
          "trust_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": ["public_key", "key_set", "schema_anchor"]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_id", "category", "status"],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE",
              "UNVERIFIED",
              "UNSUPPORTED"
            ]
          },
          "detail": {
            "type": "string"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "description"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "boolean",
            "default": true
          }
        },
        "additionalProperties": false
      }
    },
    "overall_result": {
      "type": "string",
      "enum": [
        "TECHNICAL_CHECKS_PASSED",
        "TECHNICAL_CHECKS_FAILED",
        "TECHNICAL_CHECKS_PARTIAL",
        "EXECUTION_INCOMPLETE",
        "PROFILE_UNSATISFIED"
      ]
    },
    "superseded_receipt": {
      "type": "object",
      "required": ["receipt_id", "receipt_digest"],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "receipt_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
